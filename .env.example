# =============================================================================
# Len Bible — environment variables
# Copy this file to `.env.local` and fill in values as needed.
# `.env.local` is gitignored and never committed.
# =============================================================================

# Optional: API.Bible key for licensed translations (NIV, NLT, ERV, CJB, AMP, CEB).
# Without this key, the app uses free open-source translations from helloao.org
# and displays which source is being served.
#
# Get a free key at: https://scripture.api.bible/signup
# Documentation:     https://scripture.api.bible/docs
API_BIBLE_KEY=
