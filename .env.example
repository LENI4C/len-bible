# =============================================================================
# Len Bible — environment variables
# Copy this file to `.env.local` and fill in values as needed.
# =============================================================================

# Supabase (required for auth, progress sync, leaderboard, quizzes, discuss)
# Create a project at https://supabase.com and run migrations from supabase/migrations/
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database password for running migrations locally (scripts/apply-migrations.ts)
# Supabase → Project Settings → Database → Database password
# Or paste the full URI as DATABASE_URL instead:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Supabase CLI access token (Account → Access Tokens) for `npm run db:push`
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional: API.Bible key for licensed translations (NIV, NLT, etc.)
# https://scripture.api.bible/signup
API_BIBLE_KEY=

# Required for scripts/generate-quizzes.ts (Claude API)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
